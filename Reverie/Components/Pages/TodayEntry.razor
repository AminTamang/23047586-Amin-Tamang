@page "/today"
@page "/today/{DateParam}"
@using Reverie.Services
@using Reverie.Models
@inject JournalService JournalService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="rv-page">
    <!-- DATE NAVIGATION BAR (UNCHANGED) -->
    <div class="rv-date-navigation">
        <button class="rv-nav-btn" @onclick="PreviousDay" title="Previous day">
            ◀
        </button>

        <div class="rv-current-date">
            <input type="date" @bind="EntryDate" @bind:format="yyyy-MM-dd"
                   class="rv-date-picker" />
        </div>

        <button class="rv-nav-btn" @onclick="NextDay" title="Next day">
            ▶
        </button>

        <button class="rv-nav-btn" @onclick="BackToCalendar" title="Back to Calendar">
            📅
        </button>
    </div>

    <div class="rv-entry-topbar">
        <div class="rv-entry-title">
            <h1>@PageTitle</h1>
            <div class="rv-entry-subtitle">@EntryDate.ToString("MMMM dd, yyyy (dddd)")</div>
        </div>

        <div class="rv-actions">
            <button class="rv-btn rv-btn-save" @onclick="Save" disabled="@IsSaving">
                💾 @(IsSaving ? "Saving..." : "Save")
            </button>
            <button class="rv-btn rv-btn-delete" @onclick="Delete" disabled="@(!Exists || IsSaving)">
                🗑 Delete
            </button>

            @if (ShowSaveSuccess)
            {
                <div class="rv-save-success">
                    ✅ Saved at @DateTime.Now.ToString("h:mm tt")
                </div>
            }
        </div>
    </div>

    <div class="rv-entry-shell">
        <!-- LEFT: MAIN EDITOR -->
        <div class="rv-card">
            <div class="rv-field">
                <label class="rv-label">Title</label>
                <input class="rv-input" @bind="Title" placeholder="A productive day at work..." />
            </div>

            <div class="rv-field">
                <label class="rv-label">Mood</label>

                <div class="rv-mood-grid">
                    <!-- Primary -->
                    <div>
                        <div class="rv-help">Primary (Required)</div>
                        <select class="rv-select" @bind="PrimaryMood">
                            <option value="">Select Mood</option>
                            @foreach (var m in AllMoods)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>

                        @if (ShowPrimaryRequiredError)
                        {
                            <div class="rv-error">⚠️ Primary mood is required to save.</div>
                        }
                    </div>

                    <!-- Secondary -->
                    <div>
                        <div class="rv-help">Secondary (Optional, max 2)</div>

                        <div class="rv-pill-row" style="margin-bottom:10px;">
                            @foreach (var mood in SecondaryMoods)
                            {
                                <span class="rv-pill @SecondaryMoodPillClass(mood)">
                                    @mood
                                    <button type="button" class="rv-pill-remove" title="Remove"
                                            @onclick="() => RemoveSecondaryMood(mood)">
                                        ✕
                                    </button>
                                </span>
                            }
                        </div>

                        <select class="rv-select" @onchange="OnSecondaryMoodSelected" disabled="@(SecondaryMoods.Count >= 2)">
                            <option value="">+ Add secondary mood</option>
                            @foreach (var m in AllMoods.Where(m => m != PrimaryMood && !SecondaryMoods.Contains(m)))
                            {
                                <option value="@m">@m</option>
                            }
                        </select>

                        @if (SecondaryMoods.Count >= 2)
                        {
                            <div class="rv-help" style="margin-top:6px; color: var(--rv-purple);">
                                ✓ Max 2 selected
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="rv-field">
                <label class="rv-label">Content (Rich Text Editor)</label>

                <!-- ENHANCED RICH TEXT TOOLBAR -->
                <div class="rv-toolbar rv-richtext-toolbar">
                    <!-- Text Formatting -->
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("bold"))" title="Bold (Ctrl+B)">
                        <b>B</b>
                    </button>
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("italic"))" title="Italic (Ctrl+I)">
                        <i>I</i>
                    </button>
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("underline"))" title="Underline (Ctrl+U)">
                        <u>U</u>
                    </button>

                    <!-- Headings -->
                    <div class="rv-tool-dropdown">
                        <button type="button" class="rv-tool" title="Heading">
                            H
                        </button>
                        <div class="rv-dropdown-content">
                            <button type="button" @onclick="@(() => ExecuteFormatCommand("formatBlock", "<h1>"))">Heading 1</button>
                            <button type="button" @onclick="@(() => ExecuteFormatCommand("formatBlock", "<h2>"))">Heading 2</button>
                            <button type="button" @onclick="@(() => ExecuteFormatCommand("formatBlock", "<p>"))">Normal Text</button>
                        </div>
                    </div>

                    <!-- Lists -->
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("insertUnorderedList"))" title="Bullet List">
                        • List
                    </button>
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("insertOrderedList"))" title="Numbered List">
                        1. Num
                    </button>

                    <!-- Links -->
                    <button type="button" class="rv-tool" @onclick="InsertLink" title="Insert Link">
                        🔗 Link
                    </button>

                    <!-- Clear Formatting -->
                    <button type="button" class="rv-tool" @onclick="@(() => ExecuteFormatCommand("removeFormat"))" title="Clear Formatting">
                        🧹 Clear
                    </button>
                </div>

                <!-- RICH TEXT EDITOR (replaces textarea) -->
                <div id="richTextEditor"
                     class="rv-richtext-editor"
                     contenteditable="true"
                     @onblur="OnEditorBlur"
                     @oninput="OnEditorInput"
                     @onkeydown="OnEditorKeyDown"
                     placeholder="Write about your day... Use the toolbar above to format your text.">
                    @((MarkupString)EditorHtml)
                </div>

                <div class="rv-textarea-info">
                    <span class="rv-wordcount-indicator">Words: @WordCount</span>
                    <span class="rv-char-count">Chars: @Content.Length</span>
                    <span class="rv-md-help">💡 Click toolbar buttons to format text (saved as markdown)</span>
                </div>
            </div>
        </div>

        <!-- RIGHT: TAGS / META (UNCHANGED) -->
        <div class="rv-card">
            <h3 class="rv-side-title">Tags</h3>

            <div class="rv-pill-row" style="margin-bottom: 8px;">
                @foreach (var tag in Tags)
                {
                    <span class="rv-tag-chip @TagColorClass(tag)">
                        @tag
                        <button type="button" title="Remove" @onclick="() => RemoveTag(tag)">✕</button>
                    </span>
                }
            </div>

            @if (Tags.Count == 0)
            {
                <div class="rv-empty-tags">
                    No tags added yet. Add some to categorize your entry.
                </div>
            }

            <div class="rv-section-title">Available Tags</div>
            <div class="rv-tag-available">
                @foreach (var tag in AvailableTags.Except(Tags))
                {
                    <button type="button" class="rv-tag-ghost" @onclick="() => AddTag(tag)">@tag</button>
                }
            </div>

            <div class="rv-section-title" style="margin-top: 14px;">Add Custom Tag</div>
            <div class="rv-add-tag">
                <input class="rv-input" @bind="TagInput" @bind:event="oninput"
                       placeholder="New tag..." @onkeyup="@((e) => { if (e.Key == "Enter") AddTag(); })" />
                <button type="button" class="rv-add-tag-btn" @onclick="() => AddTag()" disabled="@string.IsNullOrWhiteSpace(TagInput)">+</button>
            </div>

            <div class="rv-meta">
                <div><strong>Created:</strong> @(CreatedAt == default ? "Not created yet" : CreatedAt.ToString("MMM dd, yyyy h:mm tt"))</div>
                <div><strong>Updated:</strong> @(UpdatedAt == default ? "Not saved yet" : UpdatedAt.ToString("MMM dd, yyyy h:mm tt"))</div>
            </div>

            <div class="rv-wordcount">
                ✍️ Word Count: <strong>@WordCount</strong>
                <div class="rv-entry-status">
                    @if (Exists)
                    {
                        <span class="rv-status-saved">✓ Entry saved</span>
                    }
                    else
                    {
                        <span class="rv-status-new">📝 New entry</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? DateParam { get; set; }

    DateTime EntryDate = DateTime.Today;

    string Title = "";
    string Content = "";
    string EditorHtml = ""; // NEW: HTML for rich text editor
    string PrimaryMood = "Happy";
    List<string> SecondaryMoods = new();
    List<string> Tags = new();
    string TagInput = "";

    DateTime CreatedAt;
    DateTime UpdatedAt;

    bool IsSaving = false;
    bool ShowPrimaryRequiredError = false;
    bool ShowSaveSuccess = false;

    bool Exists => JournalService.GetByDate(EntryDate) != null;
    string PageTitle => Exists ? "Edit Entry" : "New Entry";

    int WordCount => string.IsNullOrWhiteSpace(Content)
        ? 0
        : Content.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;

    List<string> AllMoods = new()
    {
        "Happy","Grateful","Calm","Neutral","Sad","Stressed","Excited",
        "Angry","Peaceful","Anxious","Content","Lonely","Hopeful","Proud"
    };

    List<string> AvailableTags = new()
    {
        "Work","Health","Meditation","Travel","Family","Fitness","Personal",
        "Career","Studies","Goals","Dreams","Ideas","Exercise","Food","Friends"
    };

    // NEW: Setup keyboard shortcuts for rich text
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetupKeyboardShortcuts();
        }
    }

    // NEW: Keyboard shortcuts for formatting
    private async Task SetupKeyboardShortcuts()
    {
        await JS.InvokeVoidAsync("eval", @"
            document.addEventListener('keydown', function(e) {
                const editor = document.getElementById('richTextEditor');
                if (!editor || document.activeElement !== editor) return;

                // Ctrl+B for bold
                if (e.ctrlKey && e.key === 'b') {
                    e.preventDefault();
                    document.execCommand('bold');
                    editor.dispatchEvent(new Event('input', { bubbles: true }));
                }

                // Ctrl+I for italic
                if (e.ctrlKey && e.key === 'i') {
                    e.preventDefault();
                    document.execCommand('italic');
                    editor.dispatchEvent(new Event('input', { bubbles: true }));
                }

                // Ctrl+U for underline
                if (e.ctrlKey && e.key === 'u') {
                    e.preventDefault();
                    document.execCommand('underline');
                    editor.dispatchEvent(new Event('input', { bubbles: true }));
                }
            });
        ");
    }

    // NEW: Execute rich text formatting command
    async Task ExecuteFormatCommand(string command, string? value = null)
    {
        await JS.InvokeVoidAsync("markdownHelper.executeCommand", command, value);
        await UpdateContentFromEditor();
    }

    // NEW: Insert link dialog
    async Task InsertLink()
    {
        var url = await JS.InvokeAsync<string>("prompt", "Enter URL:", "https://");
        if (!string.IsNullOrWhiteSpace(url))
        {
            var text = await JS.InvokeAsync<string>("prompt", "Link text (optional):", "");
            if (string.IsNullOrWhiteSpace(text)) text = url;

            await JS.InvokeVoidAsync("markdownHelper.insertLink", url, text);
            await UpdateContentFromEditor();
        }
    }

    // NEW: Update content from editor HTML
    async Task UpdateContentFromEditor()
    {
        // Get HTML from editor
        var html = await JS.InvokeAsync<string>("markdownHelper.getEditorHtml");

        // Convert HTML to markdown for storage
        Content = await JS.InvokeAsync<string>("markdownHelper.htmlToMarkdown", html);
        EditorHtml = html;

        // Update word count
        await InvokeAsync(StateHasChanged);
    }

    // NEW: Handle editor blur
    async Task OnEditorBlur()
    {
        await UpdateContentFromEditor();
    }

    // NEW: Handle editor input
    async Task OnEditorInput()
    {
        await UpdateContentFromEditor();
    }

    // NEW: Handle key down for Enter key to preserve formatting
    async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Let the browser handle Enter normally
            await Task.Delay(50); // Small delay to allow browser to insert new line
            await UpdateContentFromEditor();
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(DateParam) &&
            DateTime.TryParse(DateParam, out var parsed))
        {
            EntryDate = parsed.Date;
        }
        else
        {
            EntryDate = DateTime.Today;
        }

        Load();
    }

    async void Load()
    {
        ShowPrimaryRequiredError = false;
        ShowSaveSuccess = false;

        var e = JournalService.GetByDate(EntryDate);
        if (e == null)
        {
            Title = "";
            Content = "";
            EditorHtml = "";
            PrimaryMood = "Happy";
            SecondaryMoods = new();
            Tags = new();
            CreatedAt = default;
            UpdatedAt = default;
            return;
        }

        Title = e.Title ?? "";
        Content = e.Content ?? "";
        // Convert saved markdown to HTML for editor
        if (!string.IsNullOrWhiteSpace(Content))
        {
            EditorHtml = await JS.InvokeAsync<string>("markdownHelper.markdownToHtml", Content);
        }
        else
        {
            EditorHtml = "";
        }
        PrimaryMood = string.IsNullOrWhiteSpace(e.PrimaryMood) ? "Happy" : e.PrimaryMood;
        SecondaryMoods = e.SecondaryMoods?.ToList() ?? new();
        Tags = e.Tags?.ToList() ?? new();
        CreatedAt = e.CreatedAt;
        UpdatedAt = e.UpdatedAt;

        // Trigger UI update
        await InvokeAsync(StateHasChanged);
    }

    async Task Save()
    {
        ShowPrimaryRequiredError = string.IsNullOrWhiteSpace(PrimaryMood);
        if (ShowPrimaryRequiredError) return;

        if (string.IsNullOrWhiteSpace(Title) && string.IsNullOrWhiteSpace(Content))
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "Entry has no title or content. Save anyway?");
            if (!confirmed) return;
        }

        IsSaving = true;
        ShowSaveSuccess = false;

        try
        {
            // Make sure we have the latest content
            await UpdateContentFromEditor();

            JournalService.Save(new JournalEntry
            {
                Date = EntryDate,
                Title = Title,
                Content = Content, // This is markdown
                PrimaryMood = PrimaryMood,
                SecondaryMoods = new(SecondaryMoods),
                Tags = new(Tags)
            });

            var e = JournalService.GetByDate(EntryDate)!;
            CreatedAt = e.CreatedAt;
            UpdatedAt = e.UpdatedAt;

            ShowSaveSuccess = true;
            await Task.Delay(2000);
            ShowSaveSuccess = false;
        }
        finally
        {
            IsSaving = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    async Task Delete()
    {
        if (!Exists) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the entry for {EntryDate:MMMM dd, yyyy}? This cannot be undone.");
        if (!confirmed) return;

        IsSaving = true;
        try
        {
            JournalService.Delete(EntryDate);

            Title = "";
            Content = "";
            EditorHtml = "";
            PrimaryMood = "Happy";
            Tags.Clear();
            SecondaryMoods.Clear();
            CreatedAt = default;
            UpdatedAt = default;
        }
        finally
        {
            IsSaving = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    void AddTag(string? tag = null)
    {
        tag ??= TagInput.Trim();
        if (string.IsNullOrWhiteSpace(tag))
        {
            TagInput = "";
            return;
        }

        tag = char.ToUpper(tag[0]) + tag[1..].ToLower();
        var exists = Tags.Any(t => string.Equals(t, tag, StringComparison.OrdinalIgnoreCase));
        if (!exists)
        {
            Tags.Add(tag);
            TagInput = "";
        }
    }

    void RemoveTag(string tag) => Tags.Remove(tag);
    void RemoveSecondaryMood(string m) => SecondaryMoods.Remove(m);

    void OnSecondaryMoodSelected(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value)) return;
        if (SecondaryMoods.Count >= 2) return;
        if (SecondaryMoods.Contains(value)) return;
        if (value == PrimaryMood) return;

        SecondaryMoods.Add(value);
    }

    void PreviousDay()
    {
        EntryDate = EntryDate.AddDays(-1);
        Load();
    }

    void NextDay()
    {
        EntryDate = EntryDate.AddDays(1);
        Load();
    }

    void BackToCalendar()
    {
        Nav.NavigateTo("/calendar");
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            EntryDate = newDate.Date;
            Load();
            await InvokeAsync(StateHasChanged);
        }
    }

    string SecondaryMoodPillClass(string m) => m.ToLowerInvariant() switch
    {
        "happy" or "grateful" or "excited" or "proud" or "hopeful" => "rv-pill-green",
        "calm" or "neutral" or "content" or "peaceful" => "rv-pill-orange",
        "sad" or "stressed" or "anxious" or "lonely" => "rv-pill-gray",
        "angry" => "rv-pill-red",
        _ => "rv-pill-purple"
    };

    string TagColorClass(string tag) => tag.ToLowerInvariant() switch
    {
        "work" or "career" => "rv-tag-work",
        "health" or "fitness" or "exercise" => "rv-tag-health",
        "meditation" or "peaceful" => "rv-tag-meditation",
        "family" or "friends" => "rv-tag-family",
        "travel" => "rv-tag-travel",
        _ => "rv-tag-generic"
    };
}