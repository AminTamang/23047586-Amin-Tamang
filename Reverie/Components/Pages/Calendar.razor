@page "/calendar"
@using Reverie.Models
@using Reverie.Services
@inject JournalService JournalService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PDFExportService PDFExportService

<div class="rv-page">
    <h1 class="rv-page-title">Calendar</h1>

    <div class="rv-cal-layout">
        <!-- LEFT: CALENDAR CARD -->
        <div class="rv-card rv-cal-card">
            <div class="rv-cal-monthbar">
                <button type="button" class="rv-cal-nav" @onclick="PrevMonth" aria-label="Previous month">◀</button>
                <div class="rv-cal-month">@CurrentMonth.ToString("MMMM yyyy")</div>
                <button type="button" class="rv-cal-nav" @onclick="NextMonth" aria-label="Next month">▶</button>
            </div>

            <div class="rv-cal-grid rv-cal-weekdays">
                @foreach (var d in WeekDays)
                {
                    <div class="rv-cal-weekday">@d</div>
                }
            </div>

            <div class="rv-cal-grid rv-cal-days">
                @foreach (var cell in Cells)
                {
                    if (cell.IsPadding)
                    {
                        <div class="rv-cal-cell rv-cal-empty"></div>
                    }
                    else
                    {
                        var date = cell.Date!.Value.Date;
                        var dayEntry = JournalService.GetByDate(date);

                        var isSelected = date == Selected.Date;
                        var isToday = date == DateTime.Today.Date;

                        var moodClass = dayEntry is null ? "" : MoodClass(dayEntry.PrimaryMood);

                        <button type="button"
                                class="rv-cal-cell rv-cal-day @(isSelected ? "is-selected" : "") @(isToday ? "is-today" : "")"
                                @onclick="() => SelectDay(date)"
                                aria-label="@date.ToString("MMMM dd, yyyy")">

                            <span class="rv-cal-daynum">@date.Day</span>

                            @if (dayEntry is not null)
                            {
                                <span class="rv-cal-dot @moodClass"></span>
                            }
                        </button>
                    }
                }
            </div>

            <div class="rv-cal-legend">
                <span class="rv-cal-legend-item"><span class="rv-cal-dot positive"></span> Positive</span>
                <span class="rv-cal-legend-item"><span class="rv-cal-dot neutral"></span> Neutral</span>
                <span class="rv-cal-legend-item"><span class="rv-cal-dot negative"></span> Negative</span>
                <span class="rv-cal-legend-item"><span class="rv-cal-dot selected"></span> Selected/Today</span>
            </div>
        </div>

        <!-- RIGHT: DETAILS CARD -->
        <div class="rv-card rv-cal-details">
            @{
                var selectedEntry = SelectedEntry;  
            }

            @if (selectedEntry is null)
            {
                <div class="rv-cal-details-head">
                    <div class="rv-cal-details-date">Select a day</div>
                    <div class="rv-cal-details-dow">—</div>
                </div>

                <div class="rv-cal-divider"></div>

                <div class="rv-cal-details-title">No entry</div>
                <div class="rv-cal-details-muted">Click a day to view entry details.</div>

                <div class="rv-cal-details-actions">
                    <button type="button" class="rv-btn rv-btn-save rv-full" disabled>Open Entry</button>
                    <button type="button" class="rv-btn rv-btn-outline rv-full" disabled>Export as PDF</button>
                </div>
            }
            else
            {
                <div class="rv-cal-details-head">
                    <div class="rv-cal-details-date">@selectedEntry.Date.ToString("MMM dd, yyyy")</div>
                    <div class="rv-cal-details-dow">@selectedEntry.Date.ToString("dddd")</div>
                </div>

                <div class="rv-cal-divider"></div>

                <div class="rv-cal-details-title">@(!string.IsNullOrWhiteSpace(selectedEntry.Title) ? selectedEntry.Title : "Untitled")</div>

                <div class="rv-cal-details-pillrow">
                    <span class="rv-cal-moodpill @MoodPillClass(selectedEntry.PrimaryMood)">
                        @selectedEntry.PrimaryMood
                    </span>
                </div>

                <div class="rv-cal-details-tagrow">
                    @foreach (var tag in (selectedEntry.Tags ?? new()))
                    {
                        <span class="rv-cal-tag">@tag</span>
                    }
                </div>

                <div class="rv-cal-details-preview">
                    @Shorten(selectedEntry.Content, 110)
                </div>

                <div class="rv-cal-details-meta">
                    📝 <strong>@WordCount(selectedEntry.Content)</strong> words
                </div>

                <div class="rv-cal-details-actions">
                    <button type="button" class="rv-btn rv-btn-save rv-full" @onclick="OpenEntry">Open Entry</button>
                    <button type="button" class="rv-btn rv-btn-outline rv-full" @onclick="ExportSelectedEntry">Export Entry</button>
                    <button type="button" class="rv-btn rv-btn-outline rv-full" @onclick="ExportMonth">Export Month</button>
                </div>
            }
        </div>
    </div>
</div>

@code
{
    record CalendarCell(DateTime? Date, bool IsPadding);

    DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime Selected = DateTime.Today;

    readonly string[] WeekDays = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    List<CalendarCell> Cells = new();

    protected override void OnInitialized()
    {
        BuildCalendar();
        SelectDay(Selected);
    }

    void BuildCalendar()
    {
        Cells.Clear();

        var first = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var last = first.AddMonths(1).AddDays(-1);

        int offset = (int)first.DayOfWeek; // 0=Sun ... 6=Sat
        for (int i = 0; i < offset; i++)
            Cells.Add(new CalendarCell(null, true));

        for (var d = first; d <= last; d = d.AddDays(1))
            Cells.Add(new CalendarCell(d, false));

        int remainder = Cells.Count % 7;
        if (remainder != 0)
        {
            int add = 7 - remainder;
            for (int i = 0; i < add; i++)
                Cells.Add(new CalendarCell(null, true));
        }
    }

    void PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        BuildCalendar();

        if (Selected.Month != CurrentMonth.Month || Selected.Year != CurrentMonth.Year)
            Selected = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
    }

    void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        BuildCalendar();

        if (Selected.Month != CurrentMonth.Month || Selected.Year != CurrentMonth.Year)
            Selected = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
    }

    void SelectDay(DateTime day) => Selected = day.Date;

    void OpenEntry() => Nav.NavigateTo($"/today/{Selected:yyyy-MM-dd}");

    JournalEntry? SelectedEntry => JournalService.GetByDate(Selected);

    // NEW: Export selected entry
    private async Task ExportSelectedEntry()
    {
        if (SelectedEntry is null) return;

        try
        {
            var pdfBytes = PDFExportService.ExportEntry(SelectedEntry);
            var fileName = $"Journal_{Selected:yyyyMMdd}.pdf";
            await SaveAndOpenPDF(pdfBytes, fileName);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // NEW: Export entire month
    private async Task ExportMonth()
    {
        try
        {
            var startDate = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
            var endDate = startDate.AddMonths(1).AddDays(-1);

            var entries = JournalService.GetEntriesInRange(startDate, endDate);

            if (!entries.Any())
            {
                await JS.InvokeVoidAsync("alert", "No entries found for this month.");
                return;
            }

            var title = $"Journal Entries - {CurrentMonth:MMMM yyyy}";
            var pdfBytes = PDFExportService.ExportEntries(entries, title);
            var fileName = $"Journal_Month_{CurrentMonth:yyyyMM}.pdf";

            await SaveAndOpenPDF(pdfBytes, fileName);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // Helper method to save and open PDF
    private async Task SaveAndOpenPDF(byte[] pdfBytes, string fileName)
    {
        var tempFilePath = Path.Combine(FileSystem.CacheDirectory, fileName);
        await File.WriteAllBytesAsync(tempFilePath, pdfBytes);

        await Launcher.Default.OpenAsync(new OpenFileRequest
        {
            File = new ReadOnlyFile(tempFilePath)
        });
    }

    string MoodClass(string mood) => (mood ?? "").ToLowerInvariant() switch
    {
        "happy" or "grateful" or "excited" or "positive" => "positive",
        "calm" or "neutral" => "neutral",
        "sad" or "stressed" or "negative" => "negative",
        _ => "neutral"
    };

    string MoodPillClass(string mood) => (mood ?? "").ToLowerInvariant() switch
    {
        "happy" or "grateful" or "excited" => "pill-green",
        "calm" or "neutral" => "pill-orange",
        "sad" or "stressed" => "pill-red",
        _ => "pill-gray"
    };

    string Shorten(string text, int max) =>
        string.IsNullOrWhiteSpace(text)
            ? ""
            : text.Length <= max ? text : text[..max] + "...";

    int WordCount(string text) =>
        string.IsNullOrWhiteSpace(text)
            ? 0
            : text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
}