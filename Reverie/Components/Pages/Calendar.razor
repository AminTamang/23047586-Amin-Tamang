@page "/calendar"
@using Reverie.Models
@using Reverie.Services
@inject JournalService JournalService
@inject NavigationManager Nav

<h1>Calendar</h1>

<div class="calendar-layout">

    <!-- CALENDAR -->
    <div class="calendar-card">

        <div class="calendar-header">
            <button class="nav-btn" @onclick="PrevMonth">◀</button>
            <h2>@CurrentMonth.ToString("MMMM yyyy")</h2>
            <button class="nav-btn" @onclick="NextMonth">▶</button>
        </div>

        <!-- Weekdays -->
        <div class="calendar-grid header">
            @foreach (var d in WeekDays)
            {
                <div class="weekday">@d</div>
            }
        </div>

        <!-- Days -->
        <div class="calendar-grid">
            @foreach (var day in Days)
            {
                if (day == null)
                {
                    <div class="day empty"></div>
                }
                else
                {
                    var entry = GetEntry(day.Value);
                    var isSelected = day.Value.Date == Selected.Date;

                    <div class="day @(isSelected ? "selected" : "")"
                         @onclick="() => SelectDay(day.Value)">

                        <span class="number">@day.Value.Day</span>

                        @if (entry != null)
                        {
                            <span class="dot @MoodClass(entry.PrimaryMood)"></span>
                        }
                    </div>
                }
            }
        </div>

        <!-- Legend -->
        <div class="legend">
            <span><span class="dot positive"></span> Positive</span>
            <span><span class="dot neutral"></span> Neutral</span>
            <span><span class="dot negative"></span> Negative</span>
            <span><span class="dot selected"></span> Selected</span>
        </div>

    </div>

    <!-- DETAILS -->
    <div class="details-card">

        @if (SelectedEntry == null)
        {
            <h3>Select a day</h3>
            <div class="entry-preview">
                Click a day to view entry details.
            </div>
        }
        else
        {
            <h3>@SelectedEntry.Date.ToString("MMM dd, yyyy")</h3>
            <div class="sub">@SelectedEntry.Date.ToString("dddd")</div>

            <div class="mood-pill @MoodClass(SelectedEntry.PrimaryMood)">
                @SelectedEntry.PrimaryMood
            </div>

            <div class="tags">
                @foreach (var tag in SelectedEntry.Tags)
                {
                    <span class="tag">@tag</span>
                }
            </div>

            <div class="entry-preview">
                @Shorten(SelectedEntry.Content, 120)
            </div>

            <div class="meta">
                📝 @WordCount(SelectedEntry.Content) words
            </div>
        }

        <button class="primary-btn full"
                @onclick="OpenEntry"
                disabled="@((SelectedEntry == null))">
            Open Entry
        </button>

        <button class="outline-btn full"
                disabled="@((SelectedEntry == null))">
            Export as PDF
        </button>

    </div>

</div>

@code {

    DateTime CurrentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime Selected = DateTime.Today;

    List<JournalEntry> Entries = new();
    List<DateTime?> Days = new();

    string[] WeekDays = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    protected override void OnInitialized()
    {
        Entries = JournalService.GetAll().ToList();
        BuildCalendar();
        SelectDay(Selected);
    }

    void BuildCalendar()
    {
        Days.Clear();

        var first = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        int offset = (int)first.DayOfWeek;
        int totalDays = DateTime.DaysInMonth(CurrentMonth.Year, CurrentMonth.Month);

        for (int i = 0; i < offset; i++)
            Days.Add(null);

        for (int d = 1; d <= totalDays; d++)
            Days.Add(new DateTime(CurrentMonth.Year, CurrentMonth.Month, d));
    }

    void PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        BuildCalendar();
    }

    void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        BuildCalendar();
    }

    void SelectDay(DateTime day)
    {
        Selected = day;
    }

    void OpenEntry()
    {
        if (SelectedEntry != null)
            Nav.NavigateTo($"/today?date={Selected:yyyy-MM-dd}");
    }

    JournalEntry? SelectedEntry =>
        Entries.FirstOrDefault(e => e.Date.Date == Selected.Date);

    JournalEntry? GetEntry(DateTime date) =>
        Entries.FirstOrDefault(e => e.Date.Date == date.Date);

    string MoodClass(string mood) => mood.ToLower() switch
    {
        "happy" or "positive" => "positive",
        "neutral" => "neutral",
        "sad" or "negative" => "negative",
        _ => "neutral"
    };

    string Shorten(string text, int max) =>
        string.IsNullOrWhiteSpace(text)
            ? ""
            : text.Length <= max ? text : text[..max] + "...";

    int WordCount(string text) =>
        string.IsNullOrWhiteSpace(text)
            ? 0
            : text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
}
