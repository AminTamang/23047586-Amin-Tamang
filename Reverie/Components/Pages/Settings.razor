@page "/settings"
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Reverie.Services.LockService LockService
@inject Reverie.Services.JournalService JournalService
@inject Reverie.Services.PDFExportService PDFExportService

<h1>Settings</h1>
<p class="subtitle">Customize your journal experience</p>

<div class="nav-row">
    <button class="secondary-btn" @onclick="GoToDashboard">🏠 Dashboard</button>
    <button class="secondary-btn" @onclick="GoToCalendar">📅 Calendar</button>
    <button class="secondary-btn" @onclick="GoToTimeline">📈 Timeline</button>
</div>

<div class="content">
    <h1 class="page-title">Settings</h1>
    <p class="page-sub">Customize your journal experience</p>

    <!-- APPEARANCE -->
    <div class="settings-card">
        <h3>🎨 Appearance</h3>
        <p class="section-desc">Choose your preferred theme</p>

        <div class="theme-row">
            <div class="theme-card @(CurrentTheme == "light" ? "active" : "")"
                 @onclick="@(() => SetTheme("light"))">
                <div class="theme-preview light"></div>
                <span>Light</span>
            </div>

            <div class="theme-card @(CurrentTheme == "dark" ? "active" : "")"
                 @onclick="@(() => SetTheme("dark"))">
                <div class="theme-preview dark"></div>
                <span>Dark</span>
            </div>
        </div>
    </div>

    <!-- SECURITY -->
    <div class="settings-card">
        <h3>🔒 Security & Privacy</h3>
        <p class="section-desc">Protect your journal entries</p>

        <div class="setting-row">
            <div>
                <strong>Enable PIN Protection</strong>
                <p class="muted">Require PIN to open the app</p>
            </div>

            <label class="switch">
                <input type="checkbox" @bind="PinEnabled" @bind:event="onchange" />
                <span class="slider"></span>
            </label>
        </div>

        @if (PinEnabled)
        {
            <div class="setting-link" @onclick="ShowPinEditor">
                Change PIN <span>→</span>
            </div>

            @if (ShowPinSetup)
            {
                <div class="pin-box">
                    <div class="pin-row">
                        <input class="text-input" maxlength="4" inputmode="numeric" placeholder="New PIN (4 digits)"
                               @bind="NewPin" @bind:event="oninput" />
                        <input class="text-input" maxlength="4" inputmode="numeric" placeholder="Confirm PIN"
                               @bind="ConfirmPin" @bind:event="oninput" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(PinMsg))
                    {
                        <div class="pin-msg">@PinMsg</div>
                    }

                    <div class="pin-actions">
                        <button class="primary-btn" @onclick="SavePin">Save PIN</button>
                        <button class="secondary-btn" @onclick="CancelPin">Cancel</button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- EXPORT -->
    <div class="settings-card">
        <h3>📤 Export & Backup</h3>
        <p class="section-desc">Export your journal entries</p>

        <div class="export-row">
            <input type="date" class="text-input" @bind="ExportStartDate" @bind:format="yyyy-MM-dd">
            <input type="date" class="text-input" @bind="ExportEndDate" @bind:format="yyyy-MM-dd">
            <button class="primary-btn small" @onclick="ExportDateRange">📄 Export PDF</button>
            <button class="secondary-btn" @onclick="ExportAll">💾 Export All</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ExportMessage))
        {
            <div class="export-message @ExportMessageClass">@ExportMessage</div>
        }
    </div>

    <!-- DATA -->
    <div class="settings-card">
        <h3>🗂 Data Management</h3>

        <div class="data-row">
            <button class="secondary-btn">Manage Tags</button>
            <button class="danger-btn">Clear All Data</button>
        </div>
    </div>
</div>

@code {
    string CurrentTheme = "light";
    bool PinEnabled = false;
    bool ShowPinSetup = false;
    string NewPin = "";
    string ConfirmPin = "";
    string PinMsg = "";

    // NEW: Export variables
    private DateTime ExportStartDate = DateTime.Today.AddDays(-7);
    private DateTime ExportEndDate = DateTime.Today;
    private string ExportMessage = "";
    private string ExportMessageClass = "export-success";

    protected override async Task OnInitializedAsync()
    {
        // Check if PIN is enabled
        PinEnabled = await LockService.IsPinEnabledAsync();
    }

    async Task SetTheme(string theme)
    {
        CurrentTheme = theme;
        await JS.InvokeVoidAsync("theme.set", theme);
    }

    // FIXED: This handles the toggle
    async Task OnPinToggleChanged()
    {
        if (PinEnabled)
        {
            // User wants to ENABLE PIN
            ShowPinSetup = true;
            PinMsg = "Set a 4-digit PIN to enable protection.";
        }
        else
        {
            // User wants to DISABLE PIN
            await LockService.SetPinEnabledAsync(false);
            ShowPinSetup = false;
            NewPin = "";
            ConfirmPin = "";
            PinMsg = "PIN protection disabled.";
        }
        StateHasChanged();
    }

    async Task SavePin()
    {
        PinMsg = "";

        if (NewPin.Length != 4 || ConfirmPin.Length != 4)
        {
            PinMsg = "PIN must be 4 digits.";
            return;
        }

        if (NewPin != ConfirmPin)
        {
            PinMsg = "PINs don't match.";
            return;
        }

        if (!NewPin.All(char.IsDigit))
        {
            PinMsg = "Only numbers allowed.";
            return;
        }

        await LockService.SetPinAsync(NewPin);
        PinEnabled = true;
        ShowPinSetup = false;
        NewPin = "";
        ConfirmPin = "";
        PinMsg = "PIN saved successfully!";
    }

    void CancelPin()
    {
        ShowPinSetup = false;
        NewPin = "";
        ConfirmPin = "";
        PinMsg = "";

        // If they cancelled setting a PIN, turn toggle back off
        if (!LockService.HasPinAsync().Result)
        {
            PinEnabled = false;
        }
    }

    void ShowPinEditor()
    {
        if (!PinEnabled)
        {
            PinMsg = "Enable PIN protection first.";
            return;
        }
        ShowPinSetup = true;
    }

    // NEW: Export date range
    private async Task ExportDateRange()
    {
        if (ExportStartDate > ExportEndDate)
        {
            ExportMessage = "Start date must be before end date.";
            ExportMessageClass = "export-error";
            StateHasChanged();
            return;
        }

        try
        {
            var entries = JournalService.GetEntriesInRange(ExportStartDate, ExportEndDate);

            if (!entries.Any())
            {
                ExportMessage = "No entries found in selected date range.";
                ExportMessageClass = "export-error";
                StateHasChanged();
                return;
            }

            var title = $"Journal Entries {ExportStartDate:MMM dd} - {ExportEndDate:MMM dd, yyyy}";
            var pdfBytes = PDFExportService.ExportEntries(entries, title);
            var fileName = $"Journal_{ExportStartDate:yyyyMMdd}_to_{ExportEndDate:yyyyMMdd}.pdf";

            await SaveAndOpenPDF(pdfBytes, fileName);

            ExportMessage = $"Exported {entries.Count} entries successfully!";
            ExportMessageClass = "export-success";
        }
        catch (Exception ex)
        {
            ExportMessage = $"Export failed: {ex.Message}";
            ExportMessageClass = "export-error";
        }

        StateHasChanged();
    }

    // NEW: Export all entries
    private async Task ExportAll()
    {
        try
        {
            var entries = JournalService.GetAll().ToList();

            if (!entries.Any())
            {
                ExportMessage = "No journal entries found.";
                ExportMessageClass = "export-error";
                StateHasChanged();
                return;
            }

            var title = $"Complete Journal Export - {DateTime.Now:MMMM dd, yyyy}";
            var pdfBytes = PDFExportService.ExportEntries(entries, title);
            var fileName = $"Journal_Complete_{DateTime.Now:yyyyMMdd}.pdf";

            await SaveAndOpenPDF(pdfBytes, fileName);

            ExportMessage = $"Exported all {entries.Count} entries successfully!";
            ExportMessageClass = "export-success";
        }
        catch (Exception ex)
        {
            ExportMessage = $"Export failed: {ex.Message}";
            ExportMessageClass = "export-error";
        }

        StateHasChanged();
    }

    // Helper method to save and open PDF
    private async Task SaveAndOpenPDF(byte[] pdfBytes, string fileName)
    {
        var tempFilePath = Path.Combine(FileSystem.CacheDirectory, fileName);
        await File.WriteAllBytesAsync(tempFilePath, pdfBytes);

        await Launcher.Default.OpenAsync(new OpenFileRequest
        {
            File = new ReadOnlyFile(tempFilePath)
        });
    }

    void GoToDashboard() => Nav.NavigateTo("/dashboard");
    void GoToCalendar() => Nav.NavigateTo("/calendar");
    void GoToTimeline() => Nav.NavigateTo("/timeline");
}