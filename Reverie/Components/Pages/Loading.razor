@page "/loading"
@inject NavigationManager Nav
@inject Reverie.Services.LockService LockService
@inject IJSRuntime JS

<div class="rv-loading">
    <div class="rv-loading-left"></div>

    <div class="rv-loading-right">
        <div class="rv-loading-logo">
            <div class="rv-loading-logo-inner">📖</div>
        </div>

        <div class="rv-loading-title">Reverie</div>
        <div class="rv-loading-sub">Every thought deserves a home</div>

        <div class="rv-loading-dots" aria-label="Loading">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot active"></span>
        </div>

        <div class="rv-loading-text">Loading...</div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Load theme if your theme.js supports it
        try { await JS.InvokeAsync<string>("theme.load"); } catch { }

        // Small delay so the loading screen is visible
        await Task.Delay(900);

        // FORCE lock check on every app launch
        // Always ensure app is locked if PIN is enabled
        if (await LockService.HasPinAsync() && await LockService.IsPinEnabledAsync())
        {
            LockService.LockApp(); // Reset to locked state on every launch
        }

        // Check if we should show lock screen
        var shouldShowLock = await LockService.ShouldShowLockAsync();

        if (shouldShowLock)
        {
            Nav.NavigateTo("/lock", replace: true);
        }
        else
        {
            Nav.NavigateTo("/dashboard", replace: true);
        }
    }
}