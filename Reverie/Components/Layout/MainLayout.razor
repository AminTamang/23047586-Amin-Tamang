@inherits LayoutComponentBase
@implements IDisposable
@inject Reverie.Services.LockService LockService
@inject NavigationManager Nav
@using Reverie.Components.Pages

@if (showLockScreen)
{
    <!-- Show only lock screen, no sidebar -->
    <div class="lock-container">
        <Lock />
    </div>
}
else
{
    <!-- Show normal layout with sidebar -->
    <div class="app-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand-block">
                <div class="brand-logo">
                    <span class="brand-logo-inner">📓</span>
                </div>
                <div class="brand-name">Reverie</div>
            </div>

            <nav class="nav-menu">
                <NavLink href="/dashboard" class="nav-item" Match="NavLinkMatch.All">
                    <span class="nav-ico">📊</span>
                    <span>Dashboard</span>
                </NavLink>

                <NavLink href="/today" class="nav-item">
                    <span class="nav-ico">✍️</span>
                    <span>Today's Entry</span>
                </NavLink>

                <NavLink href="/calendar" class="nav-item">
                    <span class="nav-ico">📅</span>
                    <span>Calendar</span>
                </NavLink>

                <NavLink href="/timeline" class="nav-item">
                    <span class="nav-ico">🗂️</span>
                    <span>Timeline</span>
                </NavLink>

                <NavLink href="/settings" class="nav-item nav-bottom">
                    <span class="nav-ico">⚙️</span>
                    <span>Settings</span>
                </NavLink>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="content">
            @Body
        </main>
    </div>
}

@code {
    private bool showLockScreen = false;
    private bool initialized = false;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to lock state changes
        LockService.LockStateChanged += OnLockStateChanged;
        
        await CheckLockState();
        initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (initialized)
        {
            await CheckLockState();
        }
    }

    private async Task CheckLockState()
    {
        var shouldShowLock = await LockService.ShouldShowLockAsync();
        
        if (shouldShowLock && !showLockScreen)
        {
            // Force navigation to lock if trying to access other pages
            var currentPath = Nav.Uri.Replace(Nav.BaseUri, "");
            if (!currentPath.StartsWith("lock", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/lock", forceLoad: true);
            }
        }
        
        showLockScreen = shouldShowLock;
        StateHasChanged();
    }

    private async void OnLockStateChanged(object? sender, bool isUnlocked)
    {
        await CheckLockState();
    }

    public void Dispose()
    {
        LockService.LockStateChanged -= OnLockStateChanged;
    }
}